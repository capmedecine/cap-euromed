---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.pages %}{% if p.sitemap %}
  {%- if p.lang == "en" %}{% assign en = p.url %}{% assign fr = p.alt_url %}{% else %}{% assign fr = p.url %}{% assign en = p.alt_url %}{% endif %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <priority>{{ p.priority | default: 0.7 }}</priority>
    {%- if p.alt_url %}
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.url }}{{ fr }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ en }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ fr }}"/>
    {%- endif %}
  </url>
{%- endif %}{% endfor %}
{%- for g in site.guides %}
  <url>
    <loc>{{ site.url }}{{ g.url }}</loc>
    <priority>{{ g.priority | default: 0.7 }}</priority>
  </url>
{%- endfor %}
</urlset>
